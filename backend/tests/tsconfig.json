{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "../dist",
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "types": ["jest", "node"],
    "rootDir": ".."
  },
  "include": ["**/*", "../src/**/*"],
  "exclude": []
}
